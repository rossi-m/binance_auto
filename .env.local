# Binance API
# demo = 模拟交易；live = 正式实盘。默认使用 demo。
BINANCE_TRADING_MODE=demo

# 测试 API
BINANCE_DEMO_API_KEY=
BINANCE_DEMO_SECRET_KEY=

# 正式 API
BINANCE_LIVE_API_KEY=
BINANCE_LIVE_SECRET_KEY=

# 旧版 bian_auto.py 兼容配置（该脚本仍固定使用 Demo）。
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# TradingAgents AI 研报控制：
# - AI_RESEARCH_MODE=manage：使用研报执行入场过滤、部分减仓和 pending 管理。
# - AI_RESEARCH_MODE=off：交易逻辑不读取、不使用 AI 研报。
# - MANUAL_AI_RESEARCH_ENABLED=1：有持仓时仍允许后台生成/刷新 AI 研报。
# - 如需彻底不跑 AI，请同时设置 AI_RESEARCH_MODE=off 和 MANUAL_AI_RESEARCH_ENABLED=0，修改后重启服务。
# Git 仓库模板默认关闭，避免部署后意外启动 AI 研究或仓位管理。
AI_RESEARCH_MODE=off
AI_ALLOW_POSITION_REDUCTION=0
MANUAL_AI_RESEARCH_ENABLED=0

# Email notification
SMTP_HOST=
SMTP_PORT=
EMAIL_SENDER=
EMAIL_PASSWORD=
EMAIL_RECEIVER=
